# -------------------------------------------------------------
# Gateway / Go Service Configurations
# -------------------------------------------------------------
# توکن احراز هویت مشترک بین SvelteKit و Gateway (الزامی)
GATEWAY_SERVICE_TOKEN=your-very-strong-service-token-here
# آدرس و پورت اجرای سرور گیت‌وی (پیش‌فرض :8080)
HTTP_ADDR=:8080
# آدرس اتصال به بروکر NATS (پیش‌فرض nats://127.0.0.1:4222)
NATS_URL=nats://127.0.0.1:4222
# حداکثر تعداد درخواست‌های هم‌زمان در حال پردازش (پیش‌فرض 64)
GATEWAY_MAX_INFLIGHT=64
# حداکثر حجم مجاز بادی درخواست به کیلوبایت (پیش‌فرض 256KiB = 262144 بایت)
GATEWAY_MAX_BODY_KIB=256
# مهلت زمانی تایم‌اوت هر درخواست به میلی‌ثانیه (پیش‌فرض 2000ms)
GATEWAY_TIMEOUT_MS=2000


# -------------------------------------------------------------
# SvelteKit Frontend Configurations (مربوط به کدهای بخش فرانت)
# -------------------------------------------------------------

# آدرس داخلی گیت‌وی برای ارتباط با بک‌اند (توسط env.GATEWAY_INTERNAL_URL استفاده می‌شود)
GATEWAY_INTERNAL_URL=http://127.0.0.1:8080
